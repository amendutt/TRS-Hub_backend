NODE_ENV=development
HOST=127.0.0.1
PORT=4173
APP_URL=http://localhost:4173
DB_DRIVER=sqlite
SQLITE_PATH=./store.sqlite

# Local testing defaults to SQLite, included with Node 22.13+; MySQL is used on Render.
# For a local MySQL test, set DB_DRIVER=mysql and run the included SQL scripts.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=trs_app
MYSQL_PASSWORD=change_this_database_password
MYSQL_DATABASE=tech_refresh_store
MYSQL_CONNECTION_LIMIT=10
MYSQL_SSL=false

# Set these before the first run. The admin is created once in MySQL.
ADMIN_EMAIL=admin@techrefreshsolution.com
ADMIN_PASSWORD=replace_with_a_long_unique_password

# Razorpay Dashboard -> Account & Settings -> API Keys.
# Start with test-mode credentials; never expose the secret in frontend code.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional transactional email through Resend; sender domain must be verified.
RESEND_API_KEY=
MAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=
